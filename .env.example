# Public app URL (used by SEO for canonical / absolute URLs)
NEXT_PUBLIC_APP_URL=https://nextelite.salmanshahriar.com

# Base URL of the backend API.
# Either form works — `.../api/v1` is used as-is, and a bare host gets `/api/v1`
# appended. To move the app onto v2, set `API_BASE_URL=.../api/v2` (an explicit
# version always wins) or change API_VERSION in src/libs/api/api-urls.ts.
# Server-only; never exposed to the browser.
API_BASE_URL=https://projectname-api.onrender.com/api/v1

# Optional Sentry DSN for server-side error monitoring
SENTRY_DSN=

# Master switch for encrypted API traffic (`{ encryptedData }`).
# false = plain JSON (default). true = every call encrypts the body and
# decrypts the response, so the backend must support it.
API_ENCRYPTION=false

# 64-character hex key. Required when API_ENCRYPTION=true.
# Must match the backend's ENCRYPTION_KEY exactly.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ENCRYPTION_KEY=