{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,template,default,sitemap,robots,manifest,route}.{ts,tsx}",
    "src/libs/query-client.ts",
    "src/libs/api/*.ts",
    "src/features/auth/hooks/*.tsx",
    "src/features/auth/server/*.ts",
    "src/features/auth/rbac/*.ts",
    "src/features/auth/schemas/*.ts",
    "src/features/i18n/*.ts",
    "src/features/site/config.ts",
    "src/components/auth/auth-animation.tsx"
  ],
  "project": [
    "src/**/*.{js,jsx,ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}"
  ],
  "ignore": ["src/components/ui/**"],
  "ignoreDependencies": [
    "tw-animate-css",
    "tailwindcss",
    "@radix-ui/react-accordion",
    "@radix-ui/react-checkbox",
    "@radix-ui/react-navigation-menu",
    "@radix-ui/react-popover",
    "@radix-ui/react-progress",
    "@radix-ui/react-radio-group",
    "@radix-ui/react-toggle",
    "@radix-ui/react-toggle-group",
    "@tanstack/react-table",
    "apexcharts",
    "embla-carousel-react",
    "input-otp",
    "react-apexcharts",
    "react-day-picker"
  ],
  "ignoreExportsUsedInFile": true
}
